{
	"compilerOptions": {
		"target": "esnext",
		"module": "commonjs",
		"rootDir": ".",
		"outDir": "./build",
		"removeComments": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"lib": ["esnext", "DOM"],
		"skipLibCheck": true
	},
	"exclude": ["node_modules"],
	"include": ["index.ts", "./src/**/*.ts"]
}
